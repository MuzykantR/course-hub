# Supabase (Project Settings → API). Service role key is server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session signing secret: 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=

# bcrypt hash of the teacher password: `node scripts/hash-password.mjs '<password>'`.
# In .env files every `$` must be escaped as `\$` (Next.js expands variables); the script
# prints the escaped line. In the Vercel dashboard paste the raw hash.
TEACHER_PASSWORD_HASH=

# Local development only — test course password used by seed.sql / e2e tests.
DEV_COURSE_PASSWORD=python-dev

# Stage 5: GitHub export (fine-grained token scoped to one repo, contents: read/write)
GITHUB_EXPORT_TOKEN=
GITHUB_EXPORT_REPO=owner/repo
# Branch to overwrite with each export (created if missing).
GITHUB_EXPORT_BRANCH=main

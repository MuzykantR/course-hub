{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(npx playwright test*)",
      "Bash(npx supabase gen types*)",
      "Bash(npx supabase migration new*)",
      "Bash(npx supabase migration list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(npx vercel ls*)",
      "Bash(npx vercel inspect*)",
      "Bash(npx vercel logs*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format.mjs" }]
      }
    ]
  }
}
